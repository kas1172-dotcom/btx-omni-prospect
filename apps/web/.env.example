# Local development may use the same-origin Vite proxy. Hosted Vercel must set
# this to the canonical HTTPS Fly API origin; authentication remains server-held.
VITE_API_BASE_URL=/api
VITE_DATA_MODE=SAMPLE
# Public browser configuration. Restrict this key to approved HTTP referrers and
# restrict its API access to the Google Maps JavaScript API. Configure billing
# and quotas in the owning Google Cloud project. Never commit a real key.
VITE_GOOGLE_MAPS_API_KEY=
# Use a production map ID in hosted environments. DEMO_MAP_ID is the local default.
VITE_GOOGLE_MAPS_MAP_ID=
