VITE_API_BASE_URL=/api
VITE_DATA_MODE=SAMPLE
VITE_AUTH_MODE=development
# Public browser configuration only. Use a domain-restricted MapTiler key in hosted environments.
# Set the style URL without a key; the browser app appends VITE_MAP_API_KEY at runtime.
VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json
VITE_MAP_API_KEY=
