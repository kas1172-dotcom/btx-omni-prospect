# Loaded from backend/.env regardless of whether startup runs from the repository
# root or backend/. Process environment variables take precedence over this file.
BTX_APP_NAME=BTX Omni Prospect
BTX_ENVIRONMENT=development
BTX_API_PREFIX=/api
BTX_DATA_MODE=SAMPLE
BTX_FRONTEND_ORIGINS=http://localhost:5173
# Hosted POC: exact comma-separated origins only; never use a wildcard with cookies.
# BTX_FRONTEND_ORIGINS=https://btx-omni-prospect.vercel.app
BTX_SESSION_TTL_SECONDS=1800
BTX_SESSION_COOKIE_NAME=btx_poc_session
# Server-only bootstrap access codes. Never expose these through VITE_* variables.
BTX_ACTION_SALESPERSON_TOKEN=development-salesperson
BTX_ACTION_MANAGER_TOKEN=development-manager
BTX_DATABASE_URL=postgresql+psycopg://btx_omni:btx_omni_dev@localhost:5432/btx_omni
# Explicitly opt in before Monitor makes network calls. It never falls back to SAMPLE.
BTX_MONITOR_MODE=disabled
BTX_MONITOR_DURABLE_STATE_ENABLED=false
BTX_MONITOR_OPERATOR_TOKEN=
BTX_MONITOR_STALE_AFTER_HOURS=48
BTX_MONITOR_WORKER_SOURCES=sam_gov,usaspending,federal_register,sec_edgar,nasa,dod,commerce,fda_openfda,company_newsroom,state_economic_development
BTX_MONITOR_SOURCE_RECORD_LIMIT=25
BTX_MONITOR_SOURCE_TARGET_LIMIT=25
BTX_MONITOR_WORKER_MAX_SECONDS=240
BTX_MONITOR_SOURCE_MIN_START_SECONDS=2
BTX_MONITOR_BRIEF_SYNTHESIS_CAP=3
BTX_MONITOR_TECHNICAL_DECOMPOSITION_CAP=3
BTX_MONITOR_BRIEF_AUTH_RETRY_SECONDS=3600
BTX_MONITOR_BRIEF_TIMEOUT_RETRY_SECONDS=300
BTX_MONITOR_BRIEF_QUOTA_RETRY_SECONDS=21600
BTX_MONITOR_BRIEF_UNAVAILABLE_RETRY_SECONDS=900
# True only after deployment explicitly provisions a scheduler.
BTX_MONITOR_SCHEDULE_CONFIGURED=false
# Optional server-side language synthesis. Without configuration Omni uses governed fallback.
BTX_AI_PROVIDER=gemini
BTX_GEMINI_MODEL=gemini-2.5-flash
BTX_GEMINI_MODE=developer
GEMINI_API_KEY=
# For enterprise Vertex/ADC set mode=vertex plus project/location; no frontend key is used.
BTX_GOOGLE_CLOUD_PROJECT=
BTX_GOOGLE_CLOUD_LOCATION=global
BTX_AI_TIMEOUT_SECONDS=20
# Required only for SAM.gov. Other adapters may be keyless but remain NOT_CONFIGURED
# until their required verified target/feed identifiers exist.
BTX_SAM_API_KEY=
# Required for SEC EDGAR fair access; include a real organization and contact.
BTX_SEC_USER_AGENT=
