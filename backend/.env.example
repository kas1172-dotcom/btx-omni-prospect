BTX_APP_NAME=BTX Omni Prospect
BTX_ENVIRONMENT=development
BTX_API_PREFIX=/api
BTX_DATA_MODE=SAMPLE
BTX_FRONTEND_ORIGINS=http://localhost:5173
BTX_DATABASE_URL=postgresql+psycopg://btx_omni:btx_omni_dev@localhost:5432/btx_omni
# Explicitly opt in before Monitor makes network calls. It never falls back to SAMPLE.
BTX_MONITOR_MODE=disabled
# Initial replaceable AI provider. AI only assists unstructured/ambiguous evidence.
BTX_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
BTX_ANTHROPIC_MODEL=claude-sonnet-5
# Required only for SAM.gov. USAspending, Federal Register, SEC, openFDA, NASA,
# DoD, Commerce, official company feeds, and state publisher sources are keyless.
BTX_SAM_API_KEY=
